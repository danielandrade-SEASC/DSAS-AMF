{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dsas-amf",
  "compatibility_date": "2026-05-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dsas-amf-db",
      "database_id": "8a510995-c7ef-475a-b20b-dbe70154528b"
    }
  ]
}
